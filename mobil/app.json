{
  "expo": {
    "name": "TPAO PTS",
    "slug": "tpao-pts-mobil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tpaopts",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F6F9"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tpao.ptsmobil",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16233A"
      },
      "package": "com.tpao.ptsmobil",
      "permissions": ["NOTIFICATIONS"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F6FED"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "BURAYA-KENDI-EAS-PROJECT-ID-NIZ-GELECEK"
      }
    }
  }
}
