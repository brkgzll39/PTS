.venv/
__pycache__/
*.pyc
*.rar
*.zip

# PTS kendisi bir .env dosyası OKUMAZ (bkz. .env.example'daki not) ama biri
# yerel bir referans olarak oluşturabilir -- gerçek sırlar (PTS_LICENSE_SECRET
# vb.) içerebileceği için asla commit edilmemeli. .env.example İSTİSNA.
.env
.env.*
!.env.example

backend/license.json
backend/cameras.json
backend/config.json
backend/database_config.json
backend/auth_secret.key
veritabani/*.db
disa_aktarilanlar/*
goruntuler/*
installer/output/
loglar/*