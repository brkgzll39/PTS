# /opt/pts-merkez/merkez.env -- izinleri: chmod 600
MERKEZ_YONETICI_KULLANICI=yonetici
MERKEZ_YONETICI_PAROLA=buraya-en-az-10-karakterlik-guclu-bir-parola
MERKEZ_VERITABANI=/opt/pts-merkez/veri/merkez.db

# Telegram bildirimi (BotFather'dan yeni bir bot; PTS kurulumlarının botundan AYRI olsun)
MERKEZ_TELEGRAM_TOKEN=
MERKEZ_TELEGRAM_SOHBET=

# E-posta bildirimi (isteğe bağlı)
MERKEZ_SMTP_SUNUCU=
MERKEZ_SMTP_PORT=587
MERKEZ_SMTP_KULLANICI=
MERKEZ_SMTP_PAROLA=
MERKEZ_SMTP_GONDEREN=
MERKEZ_SMTP_ALICI=

# Bir sorun bu kadar saniye sürerse bildir (kısa kopmalarda mesaj yağmasın). Çevrimdışı hemen bildirilir.
MERKEZ_BILDIRIM_BEKLEME_SN=600
